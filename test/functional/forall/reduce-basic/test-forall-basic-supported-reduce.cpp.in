//
// test/include headers
//
#include "RAJA_test-base.hpp"
#include "RAJA_test-camp.hpp"
#include "RAJA_test-forall-data.hpp"
#include "RAJA_test-index-types.hpp"
#include "RAJA_test-supported-reduce-execpol.hpp"

//
// Header for tests in ./tests directory
//
// Note: CMake adds ./tests as an include dir for these tests.
//
#include "test-forall-basic-@REDUCETYPE@.hpp"

//
// Data types for reduction basic tests
//
using CoreReductionDataTypeList = camp::list< int,
                                              float,
                                              double >;

using BitwiseReductionDataTypeList = camp::list< int,
                                                 unsigned int >;

using TestIdxTypeList = camp::list< RAJA::Index_type >;

using @REDUCE_BACKEND@ReduceForallSupportedReduceBasicTypes =
  Test<camp::cartesian_product<TestIdxTypeList,
                               @DATATYPES@,
                               @REDUCE_BACKEND@ReduceSupportedForallExecPols,
                               @REDUCE_BACKEND@ReducePols,
                               @APITAGLIST@>>::Types;

INSTANTIATE_TYPED_TEST_SUITE_P(@SUITEPREFIX@@REDUCE_BACKEND@Reduce,
                               Forall@REDUCETYPE@BasicTest,
                               @REDUCE_BACKEND@ReduceForallSupportedReduceBasicTypes);
